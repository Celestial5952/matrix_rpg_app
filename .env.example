# Copy to .env and fill in. .env is gitignored — never commit real credentials.
MATRIX_HOMESERVER=https://matrix.example.org
MATRIX_USER=@guildbot:example.org
MATRIX_PASSWORD=change-me
# ...or use a token instead of a password:
# MATRIX_TOKEN=syt_...

# Alias or internal !id both work. Must be a ROOM, not a space.
MATRIX_ROOM_ID=#guildhall:example.org

# Seconds spent marching between encounters. Live play defaults to 300 (5 min)
# so a contract sits in the background of your day. Set 0 to play straight
# through with no waiting.
MATRIX_TRAVEL_SECONDS=300
# How often the bot checks whether anyone has arrived. Lower = tighter timing,
# more polling. Minimum 5.
MATRIX_TRAVEL_TICK=20

# Who may use !admin (reset a character, grant gold/items, announce, backup).
# Comma-separated full MXIDs. Leave unset to have no operators at all.
# MATRIX_ADMINS=@you:example.org

# --- Discord (optional; a separate bot with its own characters) -------------
# See "Discord" in the README. Check it with: python3 -m adapters.discord --check
# DISCORD_TOKEN=
# Right-click the channel -> Copy Channel ID (turn on Developer Mode first).
# DISCORD_CHANNEL_ID=
# Numeric user IDs of operators, comma-separated.
# DISCORD_ADMINS=
# Set to false to ignore direct messages.
# DISCORD_ALLOW_DMS=true

# Snapshots of players.json + guild.json go to store/backups/. Set the hours to
# 0 to turn them off. Unchanged state is never snapshotted twice.
MATRIX_BACKUP_HOURS=24
MATRIX_BACKUP_KEEP=14
